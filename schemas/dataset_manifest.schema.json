{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-ot.local/schemas/dataset-manifest-v1.json",
  "title": "Strata-OT dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "source_url",
    "citation",
    "accessed_at",
    "terms",
    "files",
    "label_provenance",
    "geometry",
    "units",
    "coverage",
    "qc"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 3},
    "source_url": {"type": "string", "format": "uri"},
    "citation": {"type": "string", "minLength": 10},
    "accessed_at": {"type": "string", "format": "date-time"},
    "terms": {
      "type": "object",
      "required": ["status", "redistribution"],
      "properties": {
        "status": {"enum": ["open", "review_required", "gated"]},
        "redistribution": {"enum": ["allowed", "metadata_only", "unknown"]}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "sha256", "bytes"],
        "properties": {
          "relative_path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "label_provenance": {
      "enum": [
        "direct_observation",
        "numerical_weather_model_teacher",
        "large_eddy_simulation_teacher",
        "derived_proxy",
        "mixed"
      ]
    },
    "geometry": {"type": "object"},
    "instrument": {"type": ["object", "null"]},
    "wavelength_nm": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "units": {"type": "object"},
    "coverage": {"type": "object"},
    "qc": {"type": "object"}
  }
}
